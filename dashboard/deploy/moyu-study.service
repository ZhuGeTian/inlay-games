[Unit]
Description=Moyu personal study dashboard
After=network.target

[Service]
Type=simple
User=moyu-study
Group=moyu-study
WorkingDirectory=/opt/moyu-study/current
EnvironmentFile=/etc/moyu-study.env
ExecStart=/usr/bin/node /opt/moyu-study/current/server.mjs
Restart=on-failure
RestartSec=3
StateDirectory=moyu-study
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/moyu-study

[Install]
WantedBy=multi-user.target
