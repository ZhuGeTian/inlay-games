<idea-plugin>
    <id>dev.gomoku.inlay</id>
    <name>Moyu Collection</name>
    <vendor>Inlay Gomoku</vendor>
    <description><![CDATA[Play Gomoku, Doudizhu and Texas Holdem with friends in an editor block inlay. 代码数组摸鱼合集：五子棋、支持机器人补位的斗地主、支持胜率模拟机器人的四色德州，支持私有手牌、房间邀请、手动显隐和断线恢复；集成小说书架、TXT导入、章节导航及本地阅读进度；支持本地行测题库导入、单题作答、解析与错题复习。]]></description>
    <depends>com.intellij.modules.platform</depends>
    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="Gomoku" displayType="NONE"/>
        <postStartupActivity implementation="dev.gomoku.plugin.UpdateRepositoryStartup"/>
        <applicationService serviceImplementation="dev.gomoku.novel.NovelReader"/>
        <applicationService serviceImplementation="dev.gomoku.practice.PracticeSession"/>
        <postStartupActivity implementation="dev.gomoku.novel.ReaderStartup"/>
    </extensions>
    <actions>
        <action id="Moyu.Practice.Here" class="dev.gomoku.practice.PracticeActions$Here" text="在此处显示" description="把当前题目移到光标所在行，保留作答和进度">
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
        </action>
        <group id="Moyu.Practice.ContextMenu" class="dev.gomoku.practice.PracticeActions$ContextMenu" popup="true"/>
        <group id="Gomoku.Menu" text="摸鱼合集" popup="true">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <group id="Gomoku.RoomMenu" text="五子棋" popup="true">
            <action id="Gomoku.Create" class="dev.gomoku.plugin.CreateRoomAction" text="创建房间…" description="创建一个双人五子棋房间"/>
            <action id="Gomoku.Join" class="dev.gomoku.plugin.JoinRoomAction" text="加入房间…" description="输入房间码加入朋友的对局"/>
            </group>
            <group id="Ddz.Menu" text="斗地主" popup="true">
                <action id="Ddz.Create" class="dev.gomoku.plugin.CreateDdzRoomAction" text="创建房间…" description="创建三人斗地主好友房"/>
                <action id="Ddz.Join" class="dev.gomoku.plugin.JoinDdzRoomAction" text="加入房间…"/>
                <separator/>
                <action id="Ddz.Start" class="dev.gomoku.plugin.DdzStartAction" text="开始（机器人补位）" description="房主可在一人或两人时开始，机器人补齐空位"/>
                <action id="Ddz.Bid0" class="dev.gomoku.plugin.DdzBid0Action" text="不叫（0 分）"/>
                <action id="Ddz.Bid1" class="dev.gomoku.plugin.DdzBid1Action" text="叫 1 分"/>
                <action id="Ddz.Bid2" class="dev.gomoku.plugin.DdzBid2Action" text="叫 2 分"/>
                <action id="Ddz.Bid3" class="dev.gomoku.plugin.DdzBid3Action" text="叫 3 分"/>
                <separator/>
                <action id="Ddz.Play" class="dev.gomoku.plugin.DdzPlayAction" text="打出选中牌"/>
                <action id="Ddz.Pass" class="dev.gomoku.plugin.DdzPassAction" text="不出"/>
                <action id="Ddz.Ready" class="dev.gomoku.plugin.DdzReadyAction" text="准备下一局"/>
            </group>
            <group id="Texas.Menu" text="德州" popup="true">
                <action id="Texas.Create" class="dev.gomoku.plugin.CreateTexasRoomAction" text="创建房间…" description="一至三人好友房，支持机器人补位，每人 1000 虚拟积分，盲注 5/10"/>
                <action id="Texas.Join" class="dev.gomoku.plugin.JoinTexasRoomAction" text="加入房间…"/>
                <separator/>
                <action id="Texas.Start" class="dev.gomoku.plugin.TexasStartAction" text="开始（机器人补位）" description="房主可在一人或两人时开始，胜率模拟机器人补齐空位"/>
                <action id="Texas.Fold" class="dev.gomoku.plugin.TexasFoldAction" text="弃牌"/>
                <action id="Texas.Check" class="dev.gomoku.plugin.TexasCheckAction" text="过牌"/>
                <action id="Texas.Call" class="dev.gomoku.plugin.TexasCallAction" text="跟注"/>
                <action id="Texas.Raise" class="dev.gomoku.plugin.TexasRaiseAction" text="加注到…"/>
                <action id="Texas.AllIn" class="dev.gomoku.plugin.TexasAllInAction" text="全下"/>
                <action id="Texas.Ready" class="dev.gomoku.plugin.TexasReadyAction" text="准备下一手／重置积分"/>
            </group>
            <group id="Moyu.Practice.Menu" text="行测刷题" popup="true">
                <action id="Moyu.Practice.Papers" class="dev.gomoku.practice.PracticeActions$Papers" text="选择试卷…"/>
                <action id="Moyu.Practice.Mistakes" class="dev.gomoku.practice.PracticeActions$Mistakes" text="错题库（全部试卷）…"/>
                <action id="Moyu.Practice.Sections" class="dev.gomoku.practice.PracticeActions$Sections" text="板块练习…"/>
                <action id="Moyu.Practice.Import" class="dev.gomoku.practice.PracticeActions$Import" text="导入 JSON 题库…"/>
                <action id="Moyu.Practice.Sample" class="dev.gomoku.practice.PracticeActions$Sample" text="打开示例试卷"/>
                <action id="Moyu.Practice.Show" class="dev.gomoku.practice.PracticeActions$Show" text="在此处显示"/>
                <action id="Moyu.Practice.Details" class="dev.gomoku.practice.PracticeActions$Details" text="隐藏／显示试卷信息和操作栏">
                    <keyboard-shortcut keymap="$default" first-keystroke="control D"/>
                    <keyboard-shortcut keymap="Mac OS X" first-keystroke="control D" replace-all="true"/>
                    <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="control D" replace-all="true"/>
                </action>
                <action id="Moyu.Practice.PreviousPage" class="dev.gomoku.practice.PracticeActions$PreviousPage" text="上一页"/>
                <action id="Moyu.Practice.NextPage" class="dev.gomoku.practice.PracticeActions$NextPage" text="下一页"/>
                <action id="Moyu.Practice.PreviousSegment" class="dev.gomoku.practice.PracticeActions$PreviousSegment" text="上段（当前题目／解析）"/>
                <action id="Moyu.Practice.NextSegment" class="dev.gomoku.practice.PracticeActions$NextSegment" text="下段（当前题目／解析）"/>
                <action id="Moyu.Practice.Previous" class="dev.gomoku.practice.PracticeActions$Previous" text="上一题"/>
                <action id="Moyu.Practice.Next" class="dev.gomoku.practice.PracticeActions$Next" text="下一题"/>
                <action id="Moyu.Practice.A" class="dev.gomoku.practice.PracticeActions$A" text="选择 A"/>
                <action id="Moyu.Practice.B" class="dev.gomoku.practice.PracticeActions$B" text="选择 B"/>
                <action id="Moyu.Practice.C" class="dev.gomoku.practice.PracticeActions$C" text="选择 C"/>
                <action id="Moyu.Practice.D" class="dev.gomoku.practice.PracticeActions$D" text="选择 D"/>
                <action id="Moyu.Practice.Submit" class="dev.gomoku.practice.PracticeActions$Submit" text="提交答案"/>
                <action id="Moyu.Practice.Retry" class="dev.gomoku.practice.PracticeActions$Retry" text="重做本题"/>
                <action id="Moyu.Practice.Filter" class="dev.gomoku.practice.PracticeActions$Filter" text="只看错题"/>
                <action id="Moyu.Practice.Images" class="dev.gomoku.practice.PracticeActions$Images" text="查看本题原图…"/>
                <action id="Moyu.Practice.FontSize" class="dev.gomoku.practice.PracticeActions$FontSize" text="调节刷题字号…"/>
                <action id="Moyu.Practice.VisibleLines" class="dev.gomoku.practice.PracticeActions$VisibleLines" text="调节显示行数…"/>
                <action id="Moyu.Practice.Hide" class="dev.gomoku.practice.PracticeActions$Hide" text="收起"/>
            </group>
            <group id="InlayGames.Novel.Menu" text="小说" popup="true">
                <action id="InlayGames.Novel.Bookshelf" class="dev.gomoku.novel.ReaderActions$Bookshelf" text="我的书架…"/>
                <action id="InlayGames.Novel.Import" class="dev.gomoku.novel.ReaderActions$Import" text="导入 TXT 小说…"/>
                <action id="InlayGames.Novel.Search" class="dev.gomoku.novel.ReaderActions$Search" text="搜索并下载小说…"/>
                <action id="InlayGames.Novel.Visibility" class="dev.gomoku.novel.ReaderActions$Visibility" text="关闭小说显示"/>
                <action id="InlayGames.Novel.FollowCaret" class="dev.gomoku.novel.ReaderActions$FollowCaret" text="跟随光标" description="关闭后固定在当前代码位置；切换文件时重新定位"/>
                <action id="InlayGames.Novel.DisplayLines" class="dev.gomoku.novel.ReaderActions$DisplayLines" text="设置显示行数…"/>
                <action id="InlayGames.Novel.Chapters" class="dev.gomoku.novel.ReaderActions$Chapters" text="选择章节…"/>
                <action id="InlayGames.Novel.Toggle" class="dev.gomoku.novel.ReaderActions$Toggle" text="切换自动 / 手动翻段"/>
                <action id="InlayGames.Novel.Interval" class="dev.gomoku.novel.ReaderActions$Interval" text="设置翻段间隔…"/>
                <action id="InlayGames.Novel.Previous" class="dev.gomoku.novel.ReaderActions$Previous" text="上一页"/>
                <action id="InlayGames.Novel.Next" class="dev.gomoku.novel.ReaderActions$Next" text="下一页"/>
            </group>
            <action id="Gomoku.Show" class="dev.gomoku.plugin.ShowBoardAction" text="在此显示数组" description="在当前光标行下显示当前对局"/>
            <action id="Gomoku.Toggle" class="dev.gomoku.plugin.ToggleBoardAction" text="显示／隐藏内容" description="切换最近使用的刷题、小说或游戏显示，保留进度和当前对局">
                <keyboard-shortcut keymap="$default" first-keystroke="control G"/>
                <keyboard-shortcut keymap="Mac OS X" first-keystroke="control G" replace-all="true"/>
                <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="control G" replace-all="true"/>
            </action>
            <action id="Gomoku.FontSize" class="dev.gomoku.plugin.FontSizeAction" text="调节字号…" description="设置数组字号，范围 8–32"/>
            <action id="Gomoku.Copy" class="dev.gomoku.plugin.CopyRoomCodeAction" text="复制房间码"/>
            <separator/>
            <action id="Gomoku.Reconnect" class="dev.gomoku.plugin.ReconnectAction" text="重新连接"/>
            <action id="Gomoku.Resign" class="dev.gomoku.plugin.ResignAction" text="认输…"/>
            <action id="Gomoku.Leave" class="dev.gomoku.plugin.LeaveRoomAction" text="退出房间…"/>
        </group>
    </actions>
</idea-plugin>

